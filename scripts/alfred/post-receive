#!/usr/bin/env bash
# Petri deploy on alfred: `git push alfred main` from the PC. With
# receive.denyCurrentBranch=updateInstead the working tree is already updated when this hook runs.
set -euo pipefail
# the hook runs inside .git (GIT_DIR=.): the working tree is the parent folder
cd "$(dirname "$(cd "${GIT_DIR:-.}" && pwd)")"
unset GIT_DIR
while read -r _old _new ref; do
    [ "$ref" = refs/heads/main ] || { echo "only main is deployed (got $ref)"; exit 0; }
done
echo "==> docker compose build"
docker compose build
echo "done: ssh -t alfred 'cd ~/Projects/petri && docker compose run --rm petri run'"
